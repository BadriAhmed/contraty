# Copy to .env.local and adjust for your environment
# NEXT_PUBLIC_API_URL=http://localhost:8001/api/v1

# Google AdSense (required to show real ads)
# NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-xxxxxxxxxxxxxxxx
# NEXT_PUBLIC_AD_SLOT_BANNER=1234567890     # 728x90 horizontal banner
# NEXT_PUBLIC_AD_SLOT_RECTANGLE=1234567890  # 300x250 rectangle / vertical sidebar
# NEXT_PUBLIC_AD_SLOT_MOBILE=1234567890     # 320x60 mobile banner
